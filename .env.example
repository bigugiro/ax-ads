# ============================================================
# AX Ads — variáveis de ambiente (copie para .env e preencha)
# .env está no .gitignore. NUNCA commite valores reais AQUI.
# Este arquivo (.env.example) É versionado — só placeholders.
# ============================================================

# --- Supabase (projeto remoto) ---
# Painel Supabase > Project Settings > API
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_ANON_KEY="ey..."            # chave pública (front + anon)
SUPABASE_SERVICE_ROLE_KEY="ey..."    # SÓ backend/testes. Nunca no front. Bypassa RLS.

# Connection string do Postgres (Project Settings > Database > Connection string)
# Usada por migrations e testes de integração.
DATABASE_URL="postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres"

# (Opcional) Se usar o Supabase CLI:
# SUPABASE_ACCESS_TOKEN="sbp_..."
# SUPABASE_DATABASE_PASSWORD="..."

# --- Front (Vite) — apenas chaves PÚBLICAS podem ter prefixo VITE_ ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="ey..."
VITE_API_URL="http://localhost:3000"

# --- Jobs / Cron (Sprint 2) ---
# Segredo que autoriza os endpoints /cron/* (Vercel envia em Authorization: Bearer).
# Sem ele, /cron/* responde 503 (fail-closed). Gerar: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# --- Cofre de tokens (Sprint 1) ---
# Chave AES-256 (32 bytes em base64) para criptografar tokens OAuth em repouso.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_VAULT_KEY=""

# --- IA / Studio criativo (Sprint 6) ---
# Sonnet gera copy/headlines, Haiku classifica. Sem ela, /ia/* responde 503 (fail-closed).
ANTHROPIC_API_KEY=""

# --- Integrações (Sprints 1/7/8) ---
META_APP_ID=""
META_APP_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Billing (Sprint 11) — Pagar.me API v5 (core.pagar.me) ---
PAGARME_SECRET_KEY=""      # sk_test_... em dev; sk_... em prod. SÓ backend.
PAGARME_PUBLIC_KEY=""      # pk_test_... / pk_... (tokenização de cartão no front)
PAGARME_WEBHOOK_AUTH=""    # usuario:senha do basic-auth configurado no webhook
